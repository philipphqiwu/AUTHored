<div class="card" style="max-width: 600px; margin: 2rem auto; text-align: center;">
  <h2 style="color: #e53e3e;">Error</h2>
  
  <div style="margin: 1.5rem 0;">
    <p style="font-size: 1.1rem; color: #2d3748;"><%= error.message %></p>
    <p style="font-size: 0.85rem; color: #718096; margin-top: 0.5rem;">Error Code: <%= error.code %></p>
  </div>
  
  <div style="margin-top: 2rem;">
    <a href="/" class="btn btn-primary" style="margin-right: 0.5rem;">Go Home</a>
    <a href="/login" class="btn btn-primary">Login</a>
  </div>
</div>
