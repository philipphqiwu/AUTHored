<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title || 'Enable MFA' %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f5f7fa;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .card {
      background: #fff;
      border-radius: 8px;
      padding: 2rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      width: 100%;
      max-width: 420px;
    }
    h1 { font-size: 1.5rem; margin-bottom: 0.5rem; text-align: center; }
    .subtitle { text-align: center; color: #718096; font-size: 0.9rem; margin-bottom: 1.5rem; }
    .qr-container { text-align: center; margin-bottom: 1.5rem; }
    .qr-container img { border: 1px solid #e2e8f0; border-radius: 4px; }
    .manual-key {
      background: #edf2f7;
      padding: 0.75rem;
      border-radius: 4px;
      font-family: monospace;
      font-size: 0.85rem;
      text-align: center;
      word-break: break-all;
      margin-bottom: 1.5rem;
      user-select: all;
    }
    .error {
      background: #fed7d7;
      color: #9b2c2c;
      padding: 0.75rem;
      border-radius: 4px;
      margin-bottom: 1rem;
    }
    label { display: block; font-size: 0.85rem; font-weight: 500; margin-bottom: 0.25rem; color: #4a5568; }
    input {
      width: 100%;
      padding: 0.5rem 0.75rem;
      border: 1px solid #cbd5e0;
      border-radius: 4px;
      font-size: 0.9rem;
      margin-bottom: 1rem;
      text-align: center;
      letter-spacing: 0.25em;
    }
    input:focus { outline: none; border-color: #3182ce; box-shadow: 0 0 0 2px rgba(49, 130, 206, 0.2); }
    button {
      width: 100%;
      padding: 0.75rem;
      background: #3182ce;
      color: #fff;
      border: none;
      border-radius: 4px;
      font-size: 1rem;
      cursor: pointer;
    }
    button:hover { background: #2b6cb0; }
    .steps { font-size: 0.85rem; color: #4a5568; margin-bottom: 1.5rem; }
    .steps li { margin-bottom: 0.5rem; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Enable Two-Factor Authentication</h1>
    <p class="subtitle">Scan the QR code with your authenticator app</p>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <ol class="steps">
      <li>Open Google Authenticator, Authy, or similar app</li>
      <li>Scan the QR code below</li>
      <li>Enter the 6-digit code to verify</li>
    </ol>

    <% if (qrCode) { %>
      <div class="qr-container">
        <img src="<%= qrCode %>" alt="TOTP QR Code" width="200" height="200">
      </div>

      <div class="manual-key">
        <strong>Manual key:</strong><br>
        <%= manualKey %>
      </div>
    <% } %>

    <form method="POST" action="/mfa/setup">
      <input type="hidden" name="secret" value="<%= manualKey %>">
      <label>Enter 6-digit code from your app</label>
      <input type="text" name="code" required maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" placeholder="000000">
      <button type="submit">Verify &amp; Enable</button>
    </form>

    <p style="text-align: center; margin-top: 1rem;">
      <a href="/profile" style="color: #718096; text-decoration: none; font-size: 0.85rem;">Cancel</a>
    </p>
  </div>
</body>
</html>
