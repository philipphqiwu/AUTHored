<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title || 'Verify MFA' %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f5f7fa;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .card {
      background: #fff;
      border-radius: 8px;
      padding: 2rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      width: 100%;
      max-width: 400px;
    }
    h1 { font-size: 1.5rem; margin-bottom: 1.5rem; text-align: center; }
    .error {
      background: #fed7d7;
      color: #9b2c2c;
      padding: 0.75rem;
      border-radius: 4px;
      margin-bottom: 1rem;
    }
    label { display: block; font-size: 0.85rem; font-weight: 500; margin-bottom: 0.25rem; color: #4a5568; }
    input {
      width: 100%;
      padding: 0.5rem 0.75rem;
      border: 1px solid #cbd5e0;
      border-radius: 4px;
      font-size: 0.9rem;
      margin-bottom: 1rem;
      text-align: center;
      letter-spacing: 0.25em;
    }
    input:focus { outline: none; border-color: #3182ce; box-shadow: 0 0 0 2px rgba(49, 130, 206, 0.2); }
    button {
      width: 100%;
      padding: 0.75rem;
      background: #3182ce;
      color: #fff;
      border: none;
      border-radius: 4px;
      font-size: 1rem;
      cursor: pointer;
    }
    button:hover { background: #2b6cb0; }
    .toggle {
      text-align: center;
      margin-top: 1rem;
    }
    .toggle a {
      color: #3182ce;
      text-decoration: none;
      font-size: 0.85rem;
      cursor: pointer;
    }
    .toggle a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Two-Factor Verification</h1>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <% if (useRecoveryCode) { %>
      <form method="POST" action="/mfa/verify">
        <label>Enter a recovery code</label>
        <input type="text" name="recovery_code" required placeholder="XXXX-XXXX" style="letter-spacing: 0.15em;">
        <button type="submit">Verify Recovery Code</button>
      </form>
      <div class="toggle">
        <a onclick="document.getElementById('totp-form').style.display='block'; this.parentElement.style.display='none';">Use authenticator code instead</a>
      </div>
    <% } else { %>
      <form id="totp-form" method="POST" action="/mfa/verify">
        <label>Enter 6-digit code from your authenticator app</label>
        <input type="text" name="code" required maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" placeholder="000000">
        <button type="submit">Verify</button>
      </form>
      <div class="toggle">
        <a onclick="document.getElementById('recovery-form').style.display='block'; this.parentElement.style.display='none';">Use a recovery code instead</a>
      </div>
      <form id="recovery-form" method="POST" action="/mfa/verify" style="display:none;">
        <label>Enter a recovery code</label>
        <input type="text" name="recovery_code" required placeholder="XXXX-XXXX" style="letter-spacing: 0.15em;">
        <button type="submit">Verify Recovery Code</button>
      </form>
    <% } %>
  </div>
</body>
</html>
