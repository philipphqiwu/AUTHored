<div class="page-header">
  <h1>Users</h1>
  <a href="/users/new" class="btn btn-primary">+ New User</a>
</div>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Status</th>
      <th>MFA</th>
      <th>Groups</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach(user => { %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td>
          <span class="badge <%= user.status === 'active' ? 'badge-active' : 'badge-inactive' %>">
            <%= user.status %>
          </span>
        </td>
        <td>
          <% if (user.totpEnabled) { %>
            <span class="badge badge-active">Enabled</span>
          <% } else { %>
            <span class="badge" style="background: #e2e8f0; color: #718096;">Off</span>
          <% } %>
        </td>
        <td><%= user.userGroups.map(ug => ug.group.name).join(', ') || '-' %></td>
        <td class="actions">
          <a href="/users/<%= user.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
          <form method="POST" action="/users/<%= user.id %>/toggle">
            <button type="submit" class="btn btn-sm"><%= user.status === 'active' ? 'Deactivate' : 'Activate' %></button>
          </form>
          <form method="POST" action="/users/<%= user.id %>/delete">
            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete?')">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
