<h1>New Group</h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div style="background: #fed7d7; color: #9b2c2c; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem;">
    <%= error %>
  </div>
<% } %>

<div class="card">
  <form method="POST" action="/groups">
    <div class="form-group">
      <label>Name</label>
      <input type="text" name="name" value="<%= formData?.name || '' %>" required>
    </div>

    <div class="form-group">
      <label>Description</label>
      <textarea name="description" rows="3"><%= formData?.description || '' %></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Create Group</button>
      <a href="/groups" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
