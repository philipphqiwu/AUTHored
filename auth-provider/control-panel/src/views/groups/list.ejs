<div class="page-header">
  <h1>Groups</h1>
  <a href="/groups/new" class="btn btn-primary">+ New Group</a>
</div>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Members</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% groups.forEach(group => { %>
      <tr>
        <td><%= group.name %></td>
        <td><%= group.description || '-' %></td>
        <td><%= group.userGroups.length %></td>
        <td class="actions">
          <a href="/groups/<%= group.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
          <form method="POST" action="/groups/<%= group.id %>/delete">
            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete?')">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
