<h1>Edit Application</h1>

<div class="card">
  <form method="POST" action="/applications/<%= application.id %>">
    <div class="form-group">
      <label>Name</label>
      <input type="text" name="name" value="<%= application.name %>" required>
    </div>

    <div class="form-group">
      <label>Client ID</label>
      <input type="text" name="clientId" value="<%= application.clientId %>" required>
    </div>

    <div class="form-group">
      <label>Status</label>
      <select name="status">
        <option value="active" <%= application.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="inactive" <%= application.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>

    <div class="form-group">
      <label>Launch URL</label>
      <input type="url" name="launchUrl" value="<%= application.launchUrl || '' %>">
    </div>

    <div class="form-group">
      <label>Logout Notification URL</label>
      <input type="url" name="logoutNotificationUrl" value="<%= application.logoutNotificationUrl %>" required>
    </div>

    <div class="form-group">
      <label>Redirect URIs (one per line)</label>
      <textarea name="redirectUris" rows="4" placeholder="http://localhost:3002/callback"><%= application.redirectUris.map(u => u.redirectUri).join('\n') %></textarea>
    </div>

    <div class="form-group">
      <label>Allowed Groups (policies)</label>
      <select name="policyGroupIds" multiple size="5">
        <% allGroups.forEach(group => { %>
          <option value="<%= group.id %>" <%= application.policies.some(p => p.groupId === group.id) ? 'selected' : '' %>>
            <%= group.name %>
          </option>
        <% }) %>
      </select>
      <small style="color: #718096;">Hold Ctrl/Cmd to select multiple groups</small>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/applications" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
