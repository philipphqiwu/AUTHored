<h1>New Application</h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div style="background: #fed7d7; color: #9b2c2c; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem;">
    <%= error %>
  </div>
<% } %>

<div class="card">
  <form method="POST" action="/applications">
    <div class="form-group">
      <label>Name</label>
      <input type="text" name="name" value="<%= formData?.name || '' %>" required>
    </div>

    <div class="form-group">
      <label>Client ID</label>
      <input type="text" name="clientId" value="<%= formData?.clientId || '' %>" required>
    </div>

    <div class="form-group">
      <label>Client Secret</label>
      <input type="text" name="clientSecret" value="<%= formData?.clientSecret || '' %>">
    </div>

    <div class="form-group">
      <label>Launch URL</label>
      <input type="url" name="launchUrl" value="<%= formData?.launchUrl || '' %>" placeholder="http://localhost:3002">
    </div>

    <div class="form-group">
      <label>Logout Notification URL</label>
      <input type="url" name="logoutNotificationUrl" value="<%= formData?.logoutNotificationUrl || '' %>" placeholder="http://localhost:3002/internal/logout" required>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Create Application</button>
      <a href="/applications" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
