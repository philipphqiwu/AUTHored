<div class="page-header">
  <h1>Applications</h1>
  <a href="/applications/new" class="btn btn-primary">+ New Application</a>
</div>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Client ID</th>
      <th>Status</th>
      <th>Redirect URIs</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% applications.forEach(app => { %>
      <tr>
        <td><%= app.name %></td>
        <td><code><%= app.clientId %></code></td>
        <td>
          <span class="badge <%= app.status === 'active' ? 'badge-active' : 'badge-inactive' %>">
            <%= app.status %>
          </span>
        </td>
        <td>
          <% app.redirectUris.forEach(uri => { %>
            <div><%= uri.redirectUri %></div>
          <% }) %>
        </td>
        <td class="actions">
          <a href="/applications/<%= app.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
          <form method="POST" action="/applications/<%= app.id %>/toggle">
            <button type="submit" class="btn btn-sm"><%= app.status === 'active' ? 'Deactivate' : 'Activate' %></button>
          </form>
          <form method="POST" action="/applications/<%= app.id %>/delete">
            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete?')">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
